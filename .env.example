# ─────────────────────────────────────────────────────────────────────────────
# Eco Terrace AI Platform — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini AI ─────────────────────────────────────────────────────────
# Required. The app throws "GEMINI_API_KEY is missing" on startup without this.
# Obtain from: https://aistudio.google.com/app/apikey
# IMPORTANT: No spaces around the = sign.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Firebase Admin SDK (Server-Side Only) ────────────────────────────────────
# Required for /api/iot/telemetry and /api/admin/* routes.
# Points to a Firebase service-account JSON file stored OUTSIDE the project.
# Obtain: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Save the JSON to a folder outside the repo (e.g. C:\secrets\eco-terrace-sa.json)
# NEVER place the JSON inside d:\AgriTech-AI-Platform\
GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\eco-terrace-sa.json

# ── IoT Hardware Simulator ───────────────────────────────────────────────────
# Required for the POST /api/iot/telemetry endpoint.
# Must be at least 32 characters. Use the same value configured in the simulator.
# Generate one: openssl rand -hex 32
IOT_SIMULATOR_API_KEY=your_iot_simulator_api_key_minimum_32_chars

# ── Razorpay Payments (Optional — marketplace only) ──────────────────────────
# Leave blank if you are not testing payment flows.
# Obtain from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ── Plant Disease API (Optional — local ML model) ───────────────────────────
# Only needed if running the Python plant-disease inference service locally.
# Leave as default if not using it.
PLANT_DISEASE_API_URL=http://127.0.0.1:8000
